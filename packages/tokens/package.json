{
  "name": "@artisanpack-ui/tokens",
  "version": "2.0.0",
  "description": "Design tokens for the ArtisanPack UI Design System: W3C DTCG source with generated CSS custom properties, a typed TypeScript map and a PHP array.",
  "license": "MIT",
  "author": "Jacob Martella <me@jacobmartella.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArtisanPack-UI/design-system.git",
    "directory": "packages/tokens"
  },
  "bugs": {
    "url": "https://github.com/ArtisanPack-UI/design-system/issues"
  },
  "homepage": "https://github.com/ArtisanPack-UI/design-system/tree/main/packages/tokens#readme",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "apui-generate-preset": "./scripts/generate-preset.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./css": "./generated/tokens.css",
    "./php": "./generated/tokens.php",
    "./presets/php": "./generated/presets.php",
    "./presets/*.css": "./generated/presets/*.css",
    "./dtcg/*": "./tokens/*",
    "./dtcg-presets/*": "./presets/*",
    "./package.json": "./package.json",
    "./figma": "./generated/figma/variables.json"
  },
  "files": [
    "dist",
    "generated",
    "tokens",
    "presets",
    "scripts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "tokens:check": "node scripts/build-tokens.mjs --check",
    "preset": "node scripts/generate-preset.mjs",
    "preset:fixtures": "node scripts/generator-fixtures.mjs",
    "build": "npm run tokens:check && tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "figma:chunks": "node scripts/figma-chunks.mjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
