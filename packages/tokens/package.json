{
  "name": "@artisanpack-ui/tokens",
  "version": "1.0.1",
  "private": true,
  "description": "Shared design tokens, color resolver, and glass helpers for ArtisanPack UI",
  "license": "MIT",
  "author": "Jacob Martella <me@jacobmartella.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArtisanPack-UI/design-system.git",
    "directory": "packages/tokens"
  },
  "bugs": {
    "url": "https://github.com/ArtisanPack-UI/design-system/issues"
  },
  "homepage": "https://github.com/ArtisanPack-UI/design-system/tree/main/packages/tokens#readme",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./css": "./dist/tokens.css",
    "./tailwind": {
      "types": "./dist/tailwind-plugin.d.ts",
      "import": "./dist/tailwind-plugin.mjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.5.0"
  },
  "peerDependencies": {
    "clsx": "^2.1.0",
    "tailwind-merge": "^3.0.0",
    "tailwindcss": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
