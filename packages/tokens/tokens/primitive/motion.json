{
  "duration": {
    "$type": "duration",
    "$description": "Duration scale, lifted unchanged from the 1.x tokens (identical across the Livewire and React sources in the Phase 0 audit).",
    "0": { "$value": { "value": 0, "unit": "ms" } },
    "75": { "$value": { "value": 75, "unit": "ms" } },
    "100": { "$value": { "value": 100, "unit": "ms" } },
    "150": { "$value": { "value": 150, "unit": "ms" } },
    "200": { "$value": { "value": 200, "unit": "ms" } },
    "300": { "$value": { "value": 300, "unit": "ms" } },
    "500": { "$value": { "value": 500, "unit": "ms" } },
    "700": { "$value": { "value": 700, "unit": "ms" } },
    "1000": { "$value": { "value": 1000, "unit": "ms" } }
  },
  "ease": {
    "$type": "cubicBezier",
    "$description": "Standard easing curves from the 1.x tokens. The expressive spring, bounce and elastic curves are dropped: Strata's motion is calm.",
    "linear": { "$value": [0, 0, 1, 1] },
    "in": { "$value": [0.4, 0, 1, 1] },
    "out": { "$value": [0, 0, 0.2, 1] },
    "in-out": { "$value": [0.4, 0, 0.2, 1] }
  }
}
