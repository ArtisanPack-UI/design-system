{
  "name": "@artisanpack-ui/design-system",
  "private": true,
  "type": "module",
  "description": "Monorepo for the ArtisanPack UI Design System packages.",
  "license": "MIT",
  "workspaces": [
    "packages/tokens",
    "packages/css",
    "packages/behavior",
    "packages/manifest",
    "packages/testing",
    "packages/codemods",
    "apps/playground"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint packages apps",
    "lint:css": "stylelint \"packages/*/src/**/*.css\" \"packages/tokens/generated/**/*.css\" \"apps/*/src/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "npm run type-check --workspaces --if-present",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build && changeset publish",
    "tokens": "npm run tokens --workspace @artisanpack-ui/tokens",
    "playground": "npm run playground --workspace @artisanpack-ui/playground"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "playwright": "~1.64.1",
    "prettier": "^3.9.10",
    "stylelint": "~17.16.0",
    "tsup": "^9.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
